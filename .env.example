# URL do BACKEND Heroku, SEM /api e SEM barra final.
# Local: http://localhost:4000
# Vercel (Production): https://SEU-APP-BACKEND.herokuapp.com
API_INTERNAL_URL=http://localhost:4000

# Public Key de PRODUCAO do Vezora Assinaturas (nao a do Marketplace).
# Usada exclusivamente para inicializar MercadoPago.js V2 na pagina /assinatura.
# NUNCA adicionar Access Token / Client Secret aqui.
NEXT_PUBLIC_VEZORA_MP_PUBLIC_KEY=

# OneSignal Web Push — App ID PUBLICO do seu projeto web Vezora no OneSignal.
# Site URL do OneSignal: https://vezora-agendamentos.vercel.app
NEXT_PUBLIC_ONESIGNAL_APP_ID=
